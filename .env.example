# Copy to .env.local for local use. On Vercel, set both in Project Settings > Environment Variables.
ANTHROPIC_API_KEY=
# Password for the deployed site. On Vercel the site refuses everyone until this is set.
# Locally it is optional: leave empty to run without a password.
APP_PASSWORD=
# The email of the owner's account. Only that account may spend ANTHROPIC_API_KEY; everyone else needs
# a key of their own. Unset means nobody can spend it. Only matters where a database is connected.
OWNER_EMAIL=
# Optional: lets "Forgot password?" email a reset link. One mail service key, plus a sender address
# that service has approved. Without these the site tells people to ask the owner instead.
MAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=
