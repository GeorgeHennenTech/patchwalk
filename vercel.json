{
  "framework": "vite",
  "functions": {
    "api/lesson.ts": {
      "maxDuration": 120
    },
    "api/ask.ts": {
      "maxDuration": 120,
      "includeFiles": "{library/*.json,library/images/*/index.json,knowledge-cards/*.md}"
    },
    "api/image.ts": {
      "includeFiles": "library/images/**"
    },
    "api/store.ts": {
      "maxDuration": 30
    },
    "api/point.ts": {
      "maxDuration": 120,
      "includeFiles": "{library/*.json,library/images/**}"
    },
    "api/walk.ts": {
      "maxDuration": 120,
      "includeFiles": "{library/*.json,library/images/*/index.json,knowledge-cards/*.md}"
    },
    "api/serum.ts": {
      "maxDuration": 120,
      "includeFiles": "{library/*.json,library/images/*/index.json,knowledge-cards/*.md}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
